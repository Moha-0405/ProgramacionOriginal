package ejercicio11;

import java.util.Arrays;
import java.util.Scanner;

public class Ejercicio11 {

	public static void main(String[] args) {

        // Crear dos arrays de enteros de tamaño 100
        int[] array1 = new int[100];
        int[] array2 = new int[100];

        // Rellenar el primer array con los valores del 1 al 100
        for (int i = 0; i < 100; i++) {
            array1[i] = i + 1;
        }

        // Copiar el primer array al segundo array en orden inverso
        for (int i = 0; i < 100; i++) {
            array2[99 - i] = array1[i];
        }

        // Mostrar ambos arrays por pantalla
        System.out.println("Array 1: " + Arrays.toString(array1));
        System.out.println("Array 2 (en orden inverso): " + Arrays.toString(array2));
    }
}

