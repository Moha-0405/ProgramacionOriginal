package matriz;

public class MatrizBusqueda {

	public static void main(String[] args) 
	{
		int[][] temperatura;  //Declaracion
		temperatura= new int[30][12];   // Instanciación
		int temperaturaMax, mesDiaMasCaluroso=0, diaMasCaluroso;
		int[]nombreMes=new int[12];
		for(int dia=0;dia<30;dia++)
		{
			for(int mes=0; mes<12; mes++)
			{
				temperatura[dia][mes]=(int)(Math.random()*50);
				
			}
			
		}
		
		temperaturaMax=temperatura[0][0];
		for(int mes=0; mes<12; mes++)
		{
			
			for(int dia=0;dia<30;dia++)
			{
				System.out.print(temperatura[dia][mes]+"\t ||");
				if(temperaturaMax<temperatura[dia][mes])
				{
					temperaturaMax=temperatura[dia][mes];
					mesDiaMasCaluroso=nombreMes[mes];
					diaMasCaluroso=dia+1;
					
				}
				
				System.out.println();
				System.out.println("La maxima temperatura del mes : "+ mesDiaMasCaluroso);
			}
			
			
		}
		
	}

}
