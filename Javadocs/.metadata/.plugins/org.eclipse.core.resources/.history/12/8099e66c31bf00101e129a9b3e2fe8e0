package ejercicio1;

public class Ejercicio1 {

	public static void main(String[] args) 
	{
		int[][] matriz=new int[5][5];
		
		for(int i=0;i<5;i++)
		{
			for(int a=0;a<5;a++)
			{
				for(int numero=1;numero<=25;numero++)
				{
					matriz[i][a]++;
					System.out.print(matriz[i][a]+"\t ||");
				}
			}
		}
	}

}
